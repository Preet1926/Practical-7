@model Practical7.Models.FeedbackViewModel

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Student Feedback Form</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("SubmitFeedback", "Feedback", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.StudentName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control", placeholder = "Enter your full name" })
                    @Html.ValidationMessageFor(m => m.StudentName, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.RollNumber, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.RollNumber, new { @class = "form-control", placeholder = "e.g., 2024CS101" })
                    @Html.ValidationMessageFor(m => m.RollNumber, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Course, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Course, new SelectList(new[] { "B.Tech Computer Science", "B.Tech Mechanical", "BCA", "MCA", "B.Sc IT" }), "-- Select Course --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Course, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Semester, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Semester, new SelectList(new[] { "Sem 1", "Sem 2", "Sem 3", "Sem 4", "Sem 5", "Sem 6", "Sem 7", "Sem 8" }), "-- Select Semester --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Semester, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Subject, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "e.g., ASP.NET Core MVC" })
                    @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.FacultyName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.FacultyName, new { @class = "form-control", placeholder = "Teacher's name" })
                    @Html.ValidationMessageFor(m => m.FacultyName, "", new { @class = "text-danger" })
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.TeachingRating, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.TeachingRating, new { @class = "form-control", type = "number", min = "1", max = "5", placeholder = "1 to 5" })
                    @Html.ValidationMessageFor(m => m.TeachingRating, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.CourseRating, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CourseRating, new { @class = "form-control", type = "number", min = "1", max = "5", placeholder = "1 to 5" })
                    @Html.ValidationMessageFor(m => m.CourseRating, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Comments, new { @class = "form-control", rows = 4, placeholder = "Write suggestions for faculty or course improvement..." })
                @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold">Submit Student Feedback</button>
        }
    </div>
</div>